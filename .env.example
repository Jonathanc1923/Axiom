# ========================================================
# Axiom Algorithmic - Environment Configuration Template
# ========================================================

# TopstepX API Credentials
TOPSTEP_USERNAME=jonathanencina2020@gmail.com
TOPSTEP_API_KEY=O/Jvyz5VggKPKRLF69YDGJQjXIcxsKuxZbJg9rgwek0=
TOPSTEP_BASE_URL=https://api.topstepx.com

# Specific Practice Account Name (e.g., PRAC-V2-460183-17971635)
ACCOUNT_NAME=PRAC-V2-460183-17967819

# Safety Account Filter (Matches accounts containing PRAC or PRACTICE)
ACCOUNT_FILTER=PRAC

# Initial Default Symbol (ES, NQ, YM, RTY, MES, MNQ, CL, GC)
DEFAULT_SYMBOL=ES

# Automatically start autonomous trading engine on boot
AUTO_START_ENGINE=true

# Server Port (Render sets this dynamically via $PORT)
PORT=8000

# Directory for trade logs (relative or absolute)
DATA_DIR=.

# Pure VWAP 35 min Lookback (7 bars of 5m)
VWAP_SLOPE_LOOKBACK_BARS=7

# Asset-Specific Slope Thresholds (Pendiente VWAP 35 min)
MIN_SLOPE_POINTS_ES=1.0
MIN_SLOPE_POINTS_NQ=1.5
MIN_SLOPE_POINTS_YM=2.0
MIN_SLOPE_POINTS_RTY=0.30
MIN_SLOPE_POINTS_OIL=0.03
MIN_SLOPE_POINTS_GOLD=1.0

# CME Electronic Session Open Buffer (150 mins = 18:00 to 20:30 ET)
CME_OPEN_BUFFER_MINUTES=150

# Trailing Daily Profit Lock (Floats at 70% of daily peak once +$750 USD is reached)
TRAILING_DAILY_PROFIT_TRIGGER_USD=750.0
TRAILING_DAILY_PROFIT_RETAIN_PCT=0.70

# Fleet Enabled Symbols by Default (Minis and Micros simultaneously)
ENABLED_SYMBOLS=ES,NQ,MES,MNQ

# Asset-Specific Stop Loss Ticks (ES: 35t / 8.75 pts | NQ: 90t / 22.5 pts | YM: 50t)
INITIAL_SL_TICKS_ES=35
INITIAL_SL_TICKS_NQ=90
INITIAL_SL_TICKS_YM=50
INITIAL_SL_TICKS_RTY=40
INITIAL_SL_TICKS_CL=35
INITIAL_SL_TICKS_GC=35
